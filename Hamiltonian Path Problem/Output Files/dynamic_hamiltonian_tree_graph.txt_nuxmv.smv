MODULE main

VAR
  pos : {v1, v2, v3, v4, dead};
  mid_pos : {none, v1_s1};
  step_num : 1..4;
  direction : {down, diag};
  visited_1 : boolean;
  visited_2 : boolean;
  visited_3 : boolean;
  visited_4 : boolean;

DEFINE
  done := (step_num = 4 & visited_1 & visited_2 & visited_3 & visited_4);
  is_split_junction :=
    (pos = v1 & mid_pos = none) |
    (pos = v1 & mid_pos = v1_s1) |
    (pos = v3 & mid_pos = none);

  is_pass_junction :=
    (pos = v2 & mid_pos = none) |
    (pos = v4 & mid_pos = none);

  at_graph_vertex := mid_pos = none & pos != dead;

  legal_move_exists := at_graph_vertex &
    (
      (pos = v1 & (!visited_2 | !visited_3 | !visited_4)) |
      (pos = v2 & (!visited_3)) |
      (pos = v3 & (!visited_2 | !visited_4)) |
      (pos = v4 & (!visited_3))
    );

  no_legal_move := !done & at_graph_vertex & !legal_move_exists;

ASSIGN
  init(pos) := v1;
  init(mid_pos) := none;
  init(step_num) := 1;
  init(direction) := down;
  init(visited_1) := TRUE;
  init(visited_2) := FALSE;
  init(visited_3) := FALSE;
  init(visited_4) := FALSE;

  next(direction) :=
  case
    done : direction;
    pos = dead : direction;
    is_split_junction : {down, diag};
    is_pass_junction : direction;
    TRUE : direction;
  esac;

TRANS
  (
    done &
    next(direction) = direction &
    next(pos) = pos &
    next(mid_pos) = mid_pos &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  (
    pos = dead &
    next(direction) = direction &
    next(pos) = dead &
    next(mid_pos) = none &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  (
    no_legal_move &
    next(direction) = direction &
    next(pos) = dead &
    next(mid_pos) = none &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  (
    step_num < 4 &
    pos = v1 &
    mid_pos = none &
    !visited_2 &
    next(direction) = down &
    next(pos) = v2 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = TRUE &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  (
    step_num < 4 &
    pos = v1 &
    mid_pos = none &
    visited_2 &
    next(direction) = down &
    next(pos) = dead &
    next(mid_pos) = none &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  (
    step_num < 4 &
    pos = v1 &
    mid_pos = none &
    next(direction) = diag &
    next(pos) = v1 &
    next(mid_pos) = v1_s1 &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  (
    step_num < 4 &
    pos = v1 &
    mid_pos = v1_s1 &
    !visited_3 &
    next(direction) = down &
    next(pos) = v3 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = TRUE &
    next(visited_4) = visited_4
  )

  |

  (
    step_num < 4 &
    pos = v1 &
    mid_pos = v1_s1 &
    visited_3 &
    next(direction) = down &
    next(pos) = dead &
    next(mid_pos) = none &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  (
    step_num < 4 &
    pos = v1 &
    mid_pos = v1_s1 &
    !visited_4 &
    next(direction) = diag &
    next(pos) = v4 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = TRUE
  )

  |

  (
    step_num < 4 &
    pos = v1 &
    mid_pos = v1_s1 &
    visited_4 &
    next(direction) = diag &
    next(pos) = dead &
    next(mid_pos) = none &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  (
    step_num < 4 &
    pos = v2 &
    mid_pos = none &
    !visited_3 &
    next(direction) = direction &
    next(pos) = v3 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = TRUE &
    next(visited_4) = visited_4
  )

  |

  (
    step_num < 4 &
    pos = v2 &
    mid_pos = none &
    visited_3 &
    next(direction) = direction &
    next(pos) = dead &
    next(mid_pos) = none &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  (
    step_num < 4 &
    pos = v3 &
    mid_pos = none &
    !visited_2 &
    next(direction) = down &
    next(pos) = v2 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = TRUE &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  (
    step_num < 4 &
    pos = v3 &
    mid_pos = none &
    visited_2 &
    next(direction) = down &
    next(pos) = dead &
    next(mid_pos) = none &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  (
    step_num < 4 &
    pos = v3 &
    mid_pos = none &
    !visited_4 &
    next(direction) = diag &
    next(pos) = v4 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = TRUE
  )

  |

  (
    step_num < 4 &
    pos = v3 &
    mid_pos = none &
    visited_4 &
    next(direction) = diag &
    next(pos) = dead &
    next(mid_pos) = none &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  (
    step_num < 4 &
    pos = v4 &
    mid_pos = none &
    !visited_3 &
    next(direction) = direction &
    next(pos) = v3 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = TRUE &
    next(visited_4) = visited_4
  )

  |

  (
    step_num < 4 &
    pos = v4 &
    mid_pos = none &
    visited_3 &
    next(direction) = direction &
    next(pos) = dead &
    next(mid_pos) = none &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  );

-- Hamiltonian Path specifications
CTLSPEC NAME exists_hamiltonian_path := EF(done)
CTLSPEC NAME no_hamiltonian_path := AG(!done)
