MODULE main

VAR
--pos : {v1, v2, v3, v4, dead}; --error test
--step_num : 1..5; --error test

  pos : {v1, v2, v3, v4, dead}; --the current position of the agent in the routed network
  step_num : 1..4;

 -- tags which indicate if we passed those locations in our path
  visited_1 : boolean; --tag for v1
  visited_2 : boolean; --tag for v2
  visited_3 : boolean; --tag for v3
  visited_4 : boolean; --tag for v3

DEFINE
--done := (step_num = 5); --error test

  done := (step_num = 4);

  no_legal_move :=
    !done & pos != dead &
    !(
      (pos = v1 & (!visited_2 | !visited_3 | !visited_4)) |
      (pos = v2 & (!visited_1 | !visited_3)) |
      (pos = v3 & (!visited_1 | !visited_2 | !visited_4)) |
      (pos = v4 & (!visited_1 | !visited_3))
    );

ASSIGN
-- the path starts at vertex v1, and it's marked visited while all other vertices are unvisited
  init(pos) := v1; 
  init(step_num) := 1; 

  init(visited_1) := TRUE;
  init(visited_2) := FALSE;
  init(visited_3) := FALSE;
  init(visited_4) := FALSE;

TRANS

-- when at the end all vetices were visited we stay in this state -win
  (
    done &
    next(pos) = pos &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |
-- when we reach a dead end we stay in it - fail
  (
    pos = dead &
    next(pos) = dead &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |
--no legal move so next move is a dead end - fail
  (
    no_legal_move &
    next(pos) = dead &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  -- v1 -> v2
  (
    step_num < 4 &
    pos = v1 & !visited_2 &
    next(pos) = v2 &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = TRUE &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  -- v1 -> v3
  (
    step_num < 4 &
    pos = v1 & !visited_3 &
    next(pos) = v3 &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = TRUE &
    next(visited_4) = visited_4
  )

  |

  -- v1 -> v4
  (
    step_num < 4 &
    pos = v1 & !visited_4 &
    next(pos) = v4 &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = TRUE
  )

  |

  -- v2 -> v1
  (
    step_num < 4 &
    pos = v2 & !visited_1 &
    next(pos) = v1 &
    next(step_num) = step_num + 1 &
    next(visited_1) = TRUE &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  -- v2 -> v3
  (
    step_num < 4 &
    pos = v2 & !visited_3 &
    next(pos) = v3 &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = TRUE &
    next(visited_4) = visited_4
  )

  |

  -- v3 -> v1
  (
    step_num < 4 &
    pos = v3 & !visited_1 &
    next(pos) = v1 &
    next(step_num) = step_num + 1 &
    next(visited_1) = TRUE &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  -- v3 -> v2
  (
    step_num < 4 &
    pos = v3 & !visited_2 &
    next(pos) = v2 &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = TRUE &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  -- v3 -> v4
  (
    step_num < 4 &
    pos = v3 & !visited_4 &
    next(pos) = v4 &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = TRUE
  )

  |

  -- v4 -> v1
  (
    step_num < 4 &
    pos = v4 & !visited_1 &
    next(pos) = v1 &
    next(step_num) = step_num + 1 &
    next(visited_1) = TRUE &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  -- v4 -> v3
  (
    step_num < 4 &
    pos = v4 & !visited_3 &
    next(pos) = v3 &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = TRUE &
    next(visited_4) = visited_4
  );

CTLSPEC EF(done)