MODULE main

----------------------------THE GRAPH---------------------------
-- vertices: v1,v2,v3,v4
-- v1 v2
-- v1 v3 
-- v1 v4
-- v2 v3
-- v3 v4
---------------------------------------------------------------

VAR
--pos : {v1, v2, v3, v4, dead}; --error test
--step_num : 1..5; --error test

  pos : {v1, v2, v3, v4, dead}; --graph vetices
  mid_pos: {none, v1_s1, v1_s2}; --spliter vertices where none means that the agent is in pos vertex
  step_num : 1..4;

 -- tags which indicate if we passed those locations in our path
  visited_1 : boolean; --tag for v1
  visited_2 : boolean; --tag for v2
  visited_3 : boolean; --tag for v3
  visited_4 : boolean; --tag for v3

DEFINE
--done := (step_num = 5); --error test

  done := (step_num = 4);
  at_graph_vertex := mid_pos = none & pos != dead;
 
  legal_move_exists := at_graph_vertex &
    (
      (pos = v1 & (!visited_2 | !visited_3 | !visited_4)) |
      (pos = v2 & (!visited_1 | !visited_3)) |
      (pos = v3 & (!visited_1 | !visited_2 | !visited_4)) |
      (pos = v4 & (!visited_1 | !visited_3))
    );

  no_legal_move := !done & at_graph_vertex & !legal_move_exists;
    

ASSIGN
-- the path starts at vertex v1, and it's marked visited while all other vertices are unvisited
  init(pos) := v1; 
  init(mid_pos):= none;
  init(step_num) := 1; 

  init(visited_1) := TRUE;
  init(visited_2) := FALSE;
  init(visited_3) := FALSE;
  init(visited_4) := FALSE;

TRANS

-- when at the end all vetices were visited we stay in this state -win
  (
    done &
    next(pos) = pos &
    next(mid_pos) = mid_pos &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |
-- when we reach a dead end we stay in it - fail
  (
    pos = dead &
    next(pos) = dead &
    next(mid_pos) = mid_pos &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |
--no legal move so next move is a dead end - fail
  (
    no_legal_move &
    next(pos) = dead &
    next(mid_pos) = mid_pos &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |
  
---------------------------------------------------------------
-- for v1 there are 3 neighbors: v2, v3, v4
---------------------------------------------------------------

  -- v1 -> v1_s1
  (
    step_num < 4 &
    pos = v1 &
    mid_pos = none &
    (!visited_2 | !visited_3 | !visited_4) &
    next(pos) = v1 &
    next(mid_pos) = v1_s1 &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |
 
  -- v1_s1 -> v2
  (
    pos = v1 &
    mid_pos = v1_s1 &
    !visited_2 &
    next(pos) = v2 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = TRUE &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  -- v1_s1 -> v1_s2
  (
    pos = v1 &
    mid_pos = v1_s1 &
    (!visited_3 | !visited_4) &
    next(pos) = v1 &
    next(mid_pos) = v1_s2 &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  -- v1_s2 -> v3
  (
    step_num < 4 &
    pos = v1 & mid_pos = v1_s2 & !visited_3 &
    next(pos) = v3 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = TRUE &
    next(visited_4) = visited_4
  )

  |

  -- v1_s2 -> v4
  (
    step_num < 4 &
    pos = v1 & mid_pos = v1_s2 & !visited_4 &
    next(pos) = v4 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = TRUE
  )

  |

---------------------------------------------------------------
-- for v2 there is 1 neighbor: v3
--(for v1 is the starting point)
---------------------------------------------------------------

  -- v2 -> v3
  (
    step_num < 4 &
    pos = v2 & !visited_3 &
    next(pos) = v3 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = TRUE &
    next(visited_4) = visited_4
  )

  |

---------------------------------------------------------------
-- for v3 there are 2 neighbors: v2, v4
--(for v1 is the starting point)
---------------------------------------------------------------

  -- v3 -> v2
  (
    step_num < 4 &
    pos = v3 & !visited_2 &
    next(pos) = v2 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = TRUE &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  -- v3 -> v4
  (
    step_num < 4 &
    pos = v3 & !visited_4 &
    next(pos) = v4 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = TRUE
  )

  |

---------------------------------------------------------------
-- for v3 there is 1 neighbor: v3
--(for v1 is the starting point)
---------------------------------------------------------------

  -- v4 -> v3
  (
    step_num < 4 &
    pos = v4 & !visited_3 &
    next(pos) = v3 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = TRUE &
    next(visited_4) = visited_4
  );

CTLSPEC NAME exists_hamiltonian_path := EF(done)
--CTLSPEC NAME show_stuck_path := AG(!no_legal_move) --check wrong move ecample in CMD
