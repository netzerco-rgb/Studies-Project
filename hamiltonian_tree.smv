MODULE main
----------------------------THE GRAPH---------------------------
-- vertices: v1,v2,v3,v4
-- v1 v2
-- v1 v3 
-- v1 v4
-- v2 v3
-- v3 v4
---------------------------------------------------------------

VAR
--pos : {v1, v2, v3, v4, dead}; --error test
--step_num : 1..5; --error test

  pos : {v1, v2, v3, v4, dead}; --graph vetices
  mid_pos: {none, v1_s1}; --spliter vertices where none means that the agent is in pos vertex
  step_num : 1..4;
  direction : {down, diag};

 -- tags which indicate if we passed those locations in our path
  visited_1 : boolean; --tag for v1
  visited_2 : boolean; --tag for v2
  visited_3 : boolean; --tag for v3
  visited_4 : boolean; --tag for v3

DEFINE
--done := (step_num = 5); --error test

  is_split_junction:= 
  (pos=v1 & mid_pos=none) | 
  (pos=v1 & mid_pos=v1_s1) | 
  (pos=v3 & mid_pos=none);

  is_pass_junction:= 
  (pos=v2 & mid_pos=none) | 
  (pos=v4 & mid_pos=none);

  done := (step_num = 4);
  at_graph_vertex := mid_pos = none & pos != dead;
 
  legal_move_exists := at_graph_vertex &
    (
      (pos = v1 & (!visited_2 | !visited_3 | !visited_4)) |
      (pos = v2 & (!visited_3)) |
      (pos = v3 & (!visited_2 | !visited_4)) |
      (pos = v4 & (!visited_3))
    );

  no_legal_move := !done & at_graph_vertex & !legal_move_exists;
    

ASSIGN
-- the path starts at vertex v1, and it's marked visited while all other vertices are unvisited
  init(pos) := v1; 
  init(mid_pos):= none;
  init(step_num) := 1; 
  init(direction) := down;

  init(visited_1) := TRUE;
  init(visited_2) := FALSE;
  init(visited_3) := FALSE;
  init(visited_4) := FALSE;

  next(direction) :=
  case
    done : direction;
    pos = dead : direction;

    is_split_junction : {down, diag};
    is_pass_junction  : direction;

    TRUE : direction;
  esac;

TRANS
-- when at the end all vetices were visited we stay in this state -win
  (
    done &
    next(direction) = direction &
    next(pos) = pos &
    next(mid_pos) = mid_pos &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |
-- when we reach a dead end we stay in it - fail
  (
    pos = dead &
    next(direction) = direction &
    next(pos) = dead &
    next(mid_pos) = none &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |
--no legal move so next move is a dead end - fail
  (
    no_legal_move &
    next(direction) = direction &
    next(pos) = dead &
    next(mid_pos) = none &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |
  
---------------------------------------------------------------
--v1 split to: v2(down) and v1_v1(diag)
--------------------------------------------------------------- 
  -- v1 -> v2
  (
    step_num < 4 &
    pos = v1 &
    mid_pos = none &
    !visited_2 &
    next(direction) = down &
    next(pos) = v2 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = TRUE &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  -- v1 -> v1_s1
  (
    step_num < 4 &
    pos = v1 &
    mid_pos = none &
    next(direction) = diag &
    (!visited_3 | !visited_4) &
    next(pos) = v1 &
    next(mid_pos) = v1_s1 &
    next(step_num) = step_num &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

 |
---------------------------------------------------------------
--v1_s1 split to: v3(down) and v4(diag)
---------------------------------------------------------------
  -- v1_s1 -> v3 (down)
  (
    step_num < 4 &
    pos = v1 & 
    mid_pos = v1_s1 & 
    !visited_3 &
    next(direction) = down &
    next(pos) = v3 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = TRUE &
    next(visited_4) = visited_4
  )

  |

  -- v1_s1 -> v4 (diag)
  (
    step_num < 4 &
    pos = v1 & 
    mid_pos = v1_s1 & 
    !visited_4 &
    next(direction) = diag &
    next(pos) = v4 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = TRUE
  )

  |

---------------------------------------------------------------
--v2 pass to: v3
---------------------------------------------------------------

  -- v2 -> v3
  (
    step_num < 4 &
    pos = v2 & 
    mid_pos = none &
    !visited_3 &
    next(direction) = direction &
    next(pos) = v3 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = TRUE &
    next(visited_4) = visited_4
  )

  |

---------------------------------------------------------------
--v3 split to: v2(down) and v4(diag)
---------------------------------------------------------------

  -- v3 -> v2 (down)
  (
    step_num < 4 &
    pos = v3 & 
    mid_pos = none &
    !visited_2 &
    next(direction) = down &
    next(pos) = v2 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = TRUE &
    next(visited_3) = visited_3 &
    next(visited_4) = visited_4
  )

  |

  -- v3 -> v4 (diag)
  (
    step_num < 4 &
    pos = v3 & 
    mid_pos = none &
    !visited_4 &
    next(direction) = diag &
    next(pos) = v4 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = visited_3 &
    next(visited_4) = TRUE
  )

  |

---------------------------------------------------------------
--v4 pass to: v3
---------------------------------------------------------------

  -- v4 -> v3 
  (
    step_num < 4 &
    pos = v4 & 
    mid_pos = none &
    !visited_3 &
    next(direction) = direction &
    next(pos) = v3 &
    next(mid_pos) = none &
    next(step_num) = step_num + 1 &
    next(visited_1) = visited_1 &
    next(visited_2) = visited_2 &
    next(visited_3) = TRUE &
    next(visited_4) = visited_4
  );

CTLSPEC NAME exists_hamiltonian_path := EF(done)
--CTLSPEC NAME show_stuck_path := AG(!no_legal_move) --check wrong move example in CMD
